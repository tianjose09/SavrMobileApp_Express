{
  "expo": {
    "name": "Philippine FoodBank",
    "slug": "savr-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/savr_favicon.png",
    "scheme": "savrmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyB2JXJAl_wstGA0e08ttdr5hDGNq9AR-Vs"
      }
    },
    "android": {
      "package": "com.pfb.savrmobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB2JXJAl_wstGA0e08ttdr5hDGNq9AR-Vs"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/savr_favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/logowhite.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#226E45",
          "dark": {
            "backgroundColor": "#226E45"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
